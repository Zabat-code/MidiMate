# Este proyecto necesita sus devDependencies (vite, vitest) para correr
# "npm run dev" / "npm run build" / "npm test". Sin esta linea, si tu
# sistema tiene NODE_ENV=production seteado (como en esta maquina), npm
# omite silenciosamente todas las devDependencies al instalar, y el
# proyecto deja de poder compilarse aunque package.json este bien.
include=dev
